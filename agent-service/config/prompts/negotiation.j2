    "A": "<1 sentence risk summary for Option A>",
    "B": "<1 sentence risk summary for Option B>",
    "C": "<1 sentence risk summary for Option C>"
  },
  "dti_after_loan": {
    "A": <DTI percentage as float>,
    "B": <DTI percentage as float>,
    "C": <DTI percentage as float>
  },
  "affordability_verdict": "<comfortable|stretched|risky>",
